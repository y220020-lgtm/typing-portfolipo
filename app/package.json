{
  "name": "typing-app",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "tsx server/initDb.ts",
    "dev": "concurrently -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "report": "tsx server/report.ts",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "test:e2e:sso": "playwright test --config playwright.sso.config.ts",
    "test:e2e:container": "playwright test --config playwright.container.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
