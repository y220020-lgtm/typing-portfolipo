# container/typing.sh の設定の見本。cp typing.env.example typing.env として使う。
# typing.env は Git の管理外（合言葉などの秘密を書くため）。

# ---- アプリ ----
APP_NAME=typing-app
APP_PORT=3000                  # アプリの待ち受けポート（127.0.0.1 だけで待ち受ける）
DATA_DIR=$HOME/typing-data     # DB を置くフォルダー（コンテナの外。コンテナを作り直しても残る）
INIT_DB=demo                   # DB がないとき: demo = デモ用の初期データで作る / 空 = 作らずに止まる（試験運用では先に DB を作る）

# ログインの方式: local = 学籍番号 / proxy = 研究室 Web サーバーの SSO（app/README.md §3）
AUTH_MODE=local
# 以下は local で教員を使うとき
TEACHER_IDS=
# 以下は proxy のとき（PROXY_SECRET は 16 文字以上。ここ以外に書かない）
PROXY_SECRET=
TEACHER_EMAILS=
BASE_PATH=
SIGN_OUT_URL=

# ---- AI（モック用のコンテナ）----
MOCK_NAME=mock-ai
MOCK_PORT=4999
MOCK_MODE=ok                   # ok / error / garbage / slow
USE_MOCK_AI=1                  # 1 = アプリをモック AI につなぐ / 0 = モックを使わない（下の AI_* があれば本物の LLM、なければ固定問題）

# ---- 本物の LLM（研究室の Qwen）----
# 使うとき: このファイルを typing.env に写し、AI_API_KEY に研究室のトークンを入れ、USE_MOCK_AI=0 にする。
# キーは typing.env（Git の管理外）にだけ書く。このファイル（Git で共有）には書かない。
# キーが空のままだと、typing.sh は LLM の設定をアプリに渡さない。苦手克服トレーニングは規則で作った問題、レベルは固定の問題になる（アプリは止まらない）。
AI_BASE_URL=https://llm.example.ac.jp/v1
AI_MODEL=qwen3.8-27b-fp8           # GET /v1/models で確かめた id（2026-10-23）
AI_API_KEY=                        # 研究室のトークン（空のまま共有する）
AI_DISABLE_THINKING=1              # Qwen が答える前に長く考えるのを止める（止めないと遅く、本文が空になる）
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=60000                # 1 回 15 秒ほど（2026-10-23 実測）
